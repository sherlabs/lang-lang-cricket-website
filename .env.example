# Payload database — NEVER the production URL on a dev machine.
DATABASE_URI=postgres://postgres:postgres@127.0.0.1:54329/langlang_dev
DATABASE_URI_UNPOOLED=                 # prod/preview only: direct (non -pooler) Neon URL for `payload migrate`
DATABASE_POOL_MAX=5
PAYLOAD_SECRET=                        # 32+ random bytes
PAYLOAD_PUSH=false                     # 'true' only for a scratch DB that is never migrated (README); refused for non-local hosts
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
BLOB_READ_WRITE_TOKEN=                 # NEVER set locally (assertSafeEnv refuses it) → files go to ./media etc.
PAYLOAD_BLOB_FAKE=                     # tests only: '1' enables the plugin with a fake token + mocked @vercel/blob
BLOB_DELETE_DISABLED=                  # Preview only: '1' makes every plugin blob delete a logged no-op
LEGACY_BLOBS_RELEASED=                 # set to 'yes' only by the decommission PR (§13.5)
CRON_SECRET=
PLAYHQ_ORG_ID=484ced51-403a-466c-9a94-bd95eedf7319
PLAYHQ_CLIENT_ID=
PLAYHQ_TENANT=ca
PLAYHQ_CLUB_URL=                       # optional; the club's public PlayHQ page (fixtures links)
PLAYHQ_TEAM_PREFIX=Lang Lang           # stripped from PlayHQ team names ("Lang Lang B Grade" -> "B Grade"). REQUIRED in production
CANONICAL_HOST=langlangcricketclub.com # REQUIRED in production (no fallback there); redirects, canonical URLs
REDIRECT_HOSTS=www.langlangcricketclub.com,lang-lang-cricket-website.vercel.app   # hosts that 308 to CANONICAL_HOST; default is only www.<CANONICAL_HOST>
# Per-club settings read before the database exists (config/site.ts). PLAYHQ_ORG_ID, PLAYHQ_TEAM_PREFIX,
# CANONICAL_HOST and COOKIE_PREFIX have NO fallback outside local development and tests: set them for Vercel
# production AND preview, and for a self-hosted `next start` (instrumentation.ts refuses to start without them).
# CANONICAL_HOST also sets the site URL used for canonical links, the sitemap and structured data.
EXPORT_FILENAME_PREFIX=langlang        # CSV download names: <prefix>-statlab-season.csv; empty = derived from the club short name
VOTE_LABEL=                      # the award's name in the UI, e.g. "Player of the match"; empty = "Best player"
COOKIE_PREFIX=llcc                     # visitor cookie names; keep it for an existing club so saved state is not reset
CLUB_TIMEZONE=Australia/Melbourne
# Season start month (1-12) and name format (split = 2012/13, single = 2013) for imported history
SEASON_START_MONTH=7
SEASON_NAME_FORMAT=split
CLUB_LOCALE=en-AU
OFFICE_CURRENCY=AUD                      # club office currency (ISO code); seeds Club office settings, editable there
OFFICE_LOCALE=                           # club office language/region for amounts and dates; empty uses CLUB_LOCALE
PROD_DATABASE_HOST=                    # a hostname, not a secret: set on Vercel for ALL envs; the build refuses when empty
ENABLE_EXPERIMENTAL_COREPACK=          # Vercel only: '1' so the build uses the pnpm pinned in package.json
# Operator shell only (never in a file, never on Vercel):
ALLOW_REMOTE_DB=                       # 'yes' lets assertSafeEnv accept a non-local DATABASE_URI
ALLOW_REMOTE_BLOB=                     # 'yes' lets assertSafeEnv accept BLOB_READ_WRITE_TOKEN
GUARD_NO_DELAY=                        # local only: '1' skips the scripts' 5 s pause before writing to a LOCAL DB
# One-off scripts only (never set on Vercel):
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
LEGACY_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/langlang_legacy   # ETL/verify source only; the UNPOOLED (non -pooler) URL; read-only transactions; never on Vercel
PAYLOAD_ETL=                           # 'true' only while running the ETL (enables allowIDOnCreate)
# Integration tests (vitest --project int) — must be a local *_test database.
DATABASE_URI_TEST=postgres://postgres:postgres@127.0.0.1:54329/langlang_test

# Selector sign-in (optional). Facebook sign-in is off (no button, routes 404) unless BOTH are set. Never put the secret in a local file or pull it with `vercel env pull`.
FACEBOOK_APP_ID=                       # the club's Meta app id
FACEBOOK_APP_SECRET=                   # the club's Meta app secret (Sensitive on Vercel)
FACEBOOK_GRAPH_VERSION=                # empty uses FACEBOOK_GRAPH_VERSION in config/site.ts (v25.0); check Meta's deprecation notice yearly
SELECTOR_INVITE_DAYS=                  # how long a selector invite link works; empty = 14

# AI-assisted yearbook summary (optional; drafting is disabled until a key is set). Never commit a real key, and do not put one in .env.local.
AI_GATEWAY_API_KEY=                    # Vercel AI Gateway key; on Vercel the OIDC token also works
YEARBOOK_AI_MODEL=                     # a "provider/model" id from the Gateway; empty uses AI_DEFAULTS.yearbookModel in config/site.ts
AI_DAILY_DRAFT_LIMIT=                  # site-wide drafts per day; empty uses AI_DEFAULTS.dailyDraftLimit (20)

# Availability link and squads (optional)
CLUB_COUNTRY=                          # two-letter country for phone numbers and the privacy notice; empty uses the region of CLUB_LOCALE (en-AU gives AU)
TRUSTED_IP_HEADER=                     # off Vercel only: the request header your reverse proxy sets/overwrites with the caller's address (e.g. cf-connecting-ip). Empty = per-IP caps off (a startup warning is logged)

# Social posting queue (optional). Nothing here is read in the browser. Real networks are stubs in this build (they cannot be scheduled to
# yet), but the names below are the contract for the live calls. Set secrets in the host's environment (Sensitive on Vercel), never in a file.
FACEBOOK_PAGE_ID=                      # the Page to post to (separate from the selector sign-in app above)
FACEBOOK_PAGE_ACCESS_TOKEN=            # a Page access token that can post photos (Sensitive)
INSTAGRAM_BUSINESS_ACCOUNT_ID=         # a professional account linked to the Page
INSTAGRAM_ACCESS_TOKEN=                # (Sensitive)
X_API_KEY=                             # X developer project keys; writing posts needs a paid API tier (Sensitive)
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
SOCIAL_MOCK_NETWORK=                   # 'yes' turns on the Test network (never reaches a real service). Refused in production unless the next line is also 'yes'
SOCIAL_MOCK_ALLOW_PROD_DEMO=           # 'yes' allows the Test network when NODE_ENV=production (a deliberate demo only)
SOCIAL_MOCK_OUTCOME=                   # local demos: success (default), retryable, rejected, unknown, throw or slow
SOCIAL_ALLOW_LOCAL_SITE_URL=           # local only: 'yes' lets Schedule accept a non-https site address (ignored in production). CRON_SECRET (above) also guards /api/cron/social-posts

# Outbound email (optional). Off unless EMAIL_PROVIDER and EMAIL_FROM_ADDRESS are set (and RESEND_API_KEY for resend). While off, the Email
# module is hidden, its routes answer 404 and password reset by email stays refused. Never put a real key in a local file.
EMAIL_PROVIDER=                        # 'resend' (real delivery) or 'mock' (prints each message to the server log; refused on Vercel); empty = off
RESEND_API_KEY=                        # Resend API key (Sensitive on Vercel); only with EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS=                    # an address on a domain verified at the provider (SPF, DKIM, DMARC)
EMAIL_FROM_NAME=                       # empty = the club name from the Club details
EMAIL_REPLY_TO=                        # empty = the club contact email
EMAIL_BATCH_SIZE=                      # emails per batch; empty = 50
EMAIL_RATE_PER_SECOND=                 # sends per second; empty = 2
EMAIL_MAX_RECIPIENTS=                  # most people one email may go to; empty = 2000
